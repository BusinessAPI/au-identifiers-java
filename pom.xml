<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <groupId>au.com.businessapi</groupId>
  <artifactId>au-identifiers</artifactId>
  <version>1.0.0</version>
  <packaging>jar</packaging>

  <name>Australian ABN, ACN and TFN Validation for Java</name>
  <description>Validate and format Australian identifiers: ABN, ACN, ARBN, TFN, Director ID and VIN.</description>
  <url>https://github.com/BusinessAPI/au-identifiers-java</url>

  <licenses>
    <license>
      <name>MIT License</name>
      <url>https://opensource.org/licenses/MIT</url>
    </license>
  </licenses>
  <developers>
    <developer>
      <name>Business API</name>
      <email>dev@businessapi.com.au</email>
      <organization>Business API Pty Ltd</organization>
      <organizationUrl>https://businessapi.com.au</organizationUrl>
    </developer>
  </developers>
  <scm>
    <connection>scm:git:https://github.com/BusinessAPI/au-identifiers-java.git</connection>
    <developerConnection>scm:git:ssh://git@github.com/BusinessAPI/au-identifiers-java.git</developerConnection>
    <url>https://github.com/BusinessAPI/au-identifiers-java</url>
  </scm>

  <properties>
    <maven.compiler.release>8</maven.compiler.release>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
  </properties>

  <dependencies>
    <dependency>
      <groupId>org.junit.jupiter</groupId>
      <artifactId>junit-jupiter</artifactId>
      <version>5.11.3</version>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>com.fasterxml.jackson.core</groupId>
      <artifactId>jackson-databind</artifactId>
      <version>2.18.1</version>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <build>
    <plugins>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-compiler-plugin</artifactId>
        <version>3.13.0</version>
      </plugin>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-surefire-plugin</artifactId>
        <version>3.5.2</version>
      </plugin>
    </plugins>
  </build>
</project>
